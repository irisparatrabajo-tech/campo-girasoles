<!-- include:header -->

<main id="main" aria-label="Confirmación de envío">

<section class="seccion seccion-gracias">
  <div class="wrap gracias-wrap">
    <div class="sello" style="margin:0 auto 28px;"><span class="forma f-vida" aria-hidden="true"></span>Mensaje recibido.</div>
    <h1 class="t-serif-italic gracias-titulo">Gracias por escribir al campo</h1>
    <p class="texto-1-lg gracias-texto">Hemos recibido tu mensaje. Te responderemos en un máximo de 48 horas. Mientras tanto, conoce el proyecto en profundidad.</p>
    <div class="gracias-cta">
      <a class="btn btn-oscuro" href="/proyecto.html">Conocer el proyecto</a>
      <a class="btn btn-borde" href="/index.html">Volver al inicio</a>
    </div>
    <p class="gracias-contacto">¿Necesitas escribirnos antes? <a href="mailto:campodegirasoles70@gmail.com">campodegirasoles70@gmail.com</a></p>
  </div>
</section>

</main>

